<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
      http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- Load application properties -->
    <configuration-properties file="application.properties" />

    <!-- HTTP Listener -->
    <http:listener-config
        name="HTTP_Listener_config"
        doc:name="HTTP Listener config">
        <http:listener-connection
            host="0.0.0.0"
            port="${http.port}" />
    </http:listener-config>

    <!-- OpenWeather HTTP Request -->
    <http:request-config
        name="HTTP_Request_configuration"
        doc:name="HTTP Request configuration">
        <http:request-connection
            protocol="HTTPS"
            host="api.openweathermap.org"
            port="443" />
    </http:request-config>

    <!-- Weather System API Flow -->
    <flow name="travel-weather-system-apiFlow">

        <http:listener
            config-ref="HTTP_Listener_config"
            path="/weather/{country}"
            doc:name="Weather Listener" />

        <!-- Log incoming request -->
        <logger
            level="INFO"
            doc:name="Log Incoming Weather Request"
            message="Weather API request reached Mule flow"/>

        <!-- Call OpenWeather API -->
        <http:request
            method="GET"
            config-ref="HTTP_Request_configuration"
            path="/data/2.5/weather"
            doc:name="Weather Request">
            <http:query-params><![CDATA[#[output application/java
---
{
    q: attributes.uriParams.country,
    appid: p('openweather.api.key'),
    units: "metric"
}]]]></http:query-params>
        </http:request>

        <!-- Log downstream HTTP status -->
        <logger
            level="INFO"
            doc:name="Log Weather API Status"
            message="#['OpenWeather HTTP Status: ' ++ (attributes.statusCode as String)]" />

        <!-- Transform Weather Response -->
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    currentTemperature: payload.main.temp,
    weatherCondition: payload.weather[0].main,
    humidity: payload.main.humidity,
    windSpeed: payload.wind.speed
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <logger
            level="INFO"
            doc:name="Logger"
            message="#[payload]" />

    </flow>

</mule>
